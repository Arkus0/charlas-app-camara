{
  "name": "176-la-batalla-del-29n",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Juego de estrategia por cartas para el móvil sobre las elecciones generales del 29N de 2026.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "datos": "tsx scripts/construir-datos.ts",
    "simulate": "tsx scripts/simular.ts",
    "cartas": "tsx scripts/listar-cartas.ts",
    "build:artefacto": "tsc --noEmit && vite build --mode artefacto",
    "iconos": "node scripts/iconos.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-simplify": "^3.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "d3-composite-projections": "^1.4.0",
    "d3-geo": "^3.1.1",
    "sharp": "^0.33.5",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
